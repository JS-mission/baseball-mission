{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "jest": true,
  },
  "extends": [
    "airbnb-base",
    "plugin:prettier/recommended",
    "plugin:jest/recommended",
  ],
  "plugins": ["prettier", "jest"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
  },
  "rules": {
    "prettier/prettier": [
      "error",
      {
        "semi": true,
        "singleQuote": true,
        "tabWidth": 2,
        "printWidth": 80,
        "trailingComma": "es5",
        "arrowParens": "always",
      },
    ],
    "no-console": "off",
    "no-unused-vars": ["warn"],
    "import/extensions": [
      "error",
      {
        "js": "never",
        "jsx": "never",
        "mjs": "always",
      },
    ],
    "class-methods-use-this": ["off"],
  },
}
